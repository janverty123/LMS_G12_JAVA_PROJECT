# Copy this file to .env and fill in real values.
# Spring Boot does not read .env natively — see docs/SETUP.md for how these
# are wired in via application-dev.yml / your IDE run configuration / direnv.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/apptitle
DB_USERNAME=apptitle
DB_PASSWORD=apptitle_dev_password

# --- JWT ---
# Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-base64-secret-before-anything-but-local-dev
JWT_EXPIRATION_MS=86400000

# --- MinIO / S3-compatible storage ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=apptitle_admin
MINIO_SECRET_KEY=apptitle_dev_password
MINIO_BUCKET=apptitle-files
MINIO_INITIALIZE_BUCKET=true
MINIO_PRESIGNED_EXPIRY_SECONDS=900
MINIO_MAX_FILE_SIZE_BYTES=524288000

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
